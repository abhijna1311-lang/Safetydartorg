# Copy to .env.local (git-ignored) and fill in.

# Public Mapbox token (starts with pk.). Restrict it to DART domains in the Mapbox account.
# Leave empty to hide map pinning; the address fields still work.
VITE_MAPBOX_TOKEN=

# Set to true only once the Mapbox account is licensed for permanent geocoding.
# Mapbox terms require it when geocoding results are stored, as they are in safety reports.
VITE_MAPBOX_PERMANENT=false
